<%- include('partials/header') %>

<div class="page-container ticket-page-wrapper">
  <div class="breadcrumb-bar no-print">
    <a href="/my-events" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
      <span>Back to My Tickets</span>
    </a>

    <div class="ticket-top-actions">
      <a href="/my-events/calendar/<%= ticket.reg_id %>" class="btn btn-ticket-secondary" title="Add to Google Calendar or Apple iCal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Add to Calendar (.ics)</span>
      </a>

      <button onclick="window.print()" class="btn btn-ticket-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
          <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
        </svg>
        <span>Print / Save as PDF</span>
      </button>
    </div>
  </div>

  <!-- 🎟️ Premium Printable Ticket Pass -->
  <% const isCancelled = ticket.reg_status === 'cancelled' || ticket.payment_status === 'refunded'; %>
  <div class="printable-ticket-card <%= isCancelled ? 'ticket-is-void' : '' %>" id="printableTicket">
    <% if (isCancelled) { %>
      <div class="watermark-void-stamp">VOID / CANCELLED</div>
    <% } %>
    <!-- Left Main Pass Section -->
    <div class="ticket-main-body">
      <div class="ticket-brand-header">
        <div class="ticket-brand-logo">
          <svg class="ticket-brand-icon" viewBox="0 0 40 40" width="28" height="28" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="18" fill="url(#ticketPassGrad)" opacity="0.25"/>
            <path d="M20 8 L28 15 L26 26 L20 32 L14 26 L12 15 Z" fill="url(#ticketPassGrad)" stroke="white" stroke-width="1.5"/>
            <circle cx="20" cy="20" r="4" fill="white"/>
            <defs>
              <linearGradient id="ticketPassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#38bdf8;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#2563eb;stop-opacity:1" />
              </linearGradient>
            </defs>
          </svg>
          <span class="brand-name">Evantra</span>
        </div>
        <div class="ticket-header-pill <%= isCancelled ? 'pill-void' : '' %>">
          <%= isCancelled ? 'VOID / CANCELLED PASS' : 'OFFICIAL ADMISSION PASS' %>
        </div>
      </div>

      <div class="ticket-event-meta">
        <h1 class="ticket-event-name"><%= ticket.title %></h1>
        <p class="ticket-venue-address">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <%= ticket.venue %>
        </p>
      </div>

      <div class="ticket-info-grid">
        <div class="ticket-grid-cell">
          <span class="cell-label">ATTENDEE</span>
          <span class="cell-val bold"><%= ticket.user_name %></span>
          <span class="cell-sub"><%= ticket.user_email %></span>
        </div>

        <div class="ticket-grid-cell">
          <span class="cell-label">DATE & SCHEDULE</span>
          <span class="cell-val bold">
            <%= (new Date(ticket.event_date)).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
          </span>
          <span class="cell-sub">
            <%= (new Date(ticket.event_date)).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
          </span>
        </div>

        <div class="ticket-grid-cell">
          <span class="cell-label">TICKETS ALLOTTED</span>
          <span class="cell-val bold"><%= ticket.ticket_count %> Person<%= ticket.ticket_count > 1 ? 's' : '' %></span>
          <span class="cell-sub"><%= isCancelled ? 'Released to Pool' : 'General Admission' %></span>
        </div>

        <div class="ticket-grid-cell">
          <span class="cell-label">PAYMENT STATUS</span>
          <% if (isCancelled) { %>
            <span class="cell-val bold status-void">100% Refunded</span>
            <span class="cell-sub">₹<%= Number(ticket.amount || 0).toLocaleString() %> Returned</span>
          <% } else { %>
            <span class="cell-val bold status-paid">Confirmed & Paid</span>
            <span class="cell-sub">₹<%= Number(ticket.amount || 0).toLocaleString() %> INR</span>
          <% } %>
        </div>
      </div>

      <div class="ticket-notice-footer">
        <% if (isCancelled) { %>
          <span style="color: #ef4444; font-weight: 600;">● NOTICE: This pass was cancelled by the attendee. The barcode is deactivated and void for venue entry.</span>
        <% } else { %>
          <span>● Please present this digital pass or printed copy at the entrance for barcode check-in.</span>
        <% } %>
      </div>
    </div>

    <!-- Perforated Cut Line with Notches -->
    <div class="ticket-cut-divider">
      <div class="notch top-notch"></div>
      <div class="dashed-line"></div>
      <div class="notch bottom-notch"></div>
    </div>

    <!-- Right Stub / Scannable QR Code Section -->
    <div class="ticket-stub-section">
      <div class="pass-id-label">PASS ID</div>
      <div class="pass-id-number">#<%= String(ticket.reg_id).padStart(6, '0') %></div>

      <!-- Scannable QR Code -->
      <div class="ticket-qr-container">
        <% 
          const qrPayload = encodeURIComponent(`EVANTRA-PASS-V1|ID:${ticket.reg_id}|EVENT:${ticket.title}|ATTENDEE:${ticket.user_name}|SEATS:${ticket.ticket_count}`);
        %>
        <img 
          src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= qrPayload %>" 
          alt="Ticket QR Code" 
          class="ticket-qr-img"
          loading="eager"
        >
      </div>
      <div class="qr-sub-text">SCAN FOR ENTRY</div>

      <!-- Simulated Barcode Lines -->
      <div class="ticket-barcode-strip">
        <div class="barcode-lines"></div>
        <div class="barcode-number">EVT-<%= String(ticket.reg_id).padStart(6, '0') %>-<%= (new Date(ticket.event_date)).getFullYear() %></div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
