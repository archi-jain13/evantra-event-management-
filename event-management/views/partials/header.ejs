<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Evantra - Modern Event Management Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

<header class="navbar-wrapper">
  <div class="navbar-container">
    <!-- LEFT: Logo and Primary Navigation -->
    <div class="nav-left">
      <a href="/events" class="logo">
        <svg class="logo-icon" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="18" fill="url(#logoGradient)" opacity="0.2"/>
          <path d="M20 8 L28 15 L26 26 L20 32 L14 26 L12 15 Z" fill="url(#logoGradient)" stroke="white" stroke-width="1.5"/>
          <circle cx="20" cy="20" r="4" fill="white"/>
          <defs>
            <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#06b6d4;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
            </linearGradient>
          </defs>
        </svg>
        <span class="logo-text">Evantra</span>
      </a>

      <nav class="nav-links-left">
        <a href="/events" class="nav-link-item">Explore Events</a>
        <% if (user) { %>
          <a href="/my-events" class="nav-link-item">My Tickets</a>
          <a href="/user-events/my-submissions" class="nav-link-item">My Submissions</a>
          <a href="/user-events/submit" class="nav-link-pill create-pill">+ Submit Event</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="nav-link-pill admin-pill">Admin</a>
            <a href="/admin/create" class="nav-link-pill admin-create-pill">+ Admin Event</a>
          <% } %>
        <% } %>
      </nav>
    </div>

    <!-- RIGHT CORNER: Login / Sign Up OR User Profile + Dark Mode Toggle -->
    <div class="nav-right">
      <% if (user) { %>
        <div class="user-profile-badge">
          <span class="user-avatar-circle"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></span>
          <span class="user-greeting">Hi, <strong><%= user.name %></strong></span>
        </div>
        <a href="/logout" class="nav-btn-logout">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-btn-login">Login</a>
        <a href="/register" class="nav-btn-signup">Sign Up</a>
      <% } %>

      <!-- Dark Mode Toggle -->
      <div class="toggle-container">
        <input type="checkbox" id="dark-toggle">
        <label for="dark-toggle" class="toggle-label" title="Toggle Dark/Light Mode">
          <svg class="theme-icon theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </label>
      </div>
    </div>
  </div>
</header>

<main class="content">
