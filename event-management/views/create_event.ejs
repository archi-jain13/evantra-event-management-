<%- include('partials/header') %>
<section class="auth-page-section">
  <div class="auth-card-modern" style="max-width: 580px;">
    <div class="auth-header">
      <div class="auth-icon-circle">➕</div>
      <h1>Create New Event</h1>
      <p>Publish an event directly to the platform as Administrator</p>
    </div>

    <form action="/admin/create" method="POST" class="auth-form-styled">
      <div class="form-group-modern">
        <label for="title">Event Title *</label>
        <input type="text" id="title" name="title" placeholder="e.g. NextGen Web & AI Conference" required class="modern-input">
      </div>

      <div class="form-group-modern">
        <label for="description">Event Description *</label>
        <textarea id="description" name="description" placeholder="Provide a detailed description of the event agenda, speakers, and topics..." rows="4" required class="modern-input" style="height: auto; resize: vertical;"></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group-modern">
          <label for="event_date">Date & Time *</label>
          <input type="datetime-local" id="event_date" name="event_date" required class="modern-input">
        </div>

        <div class="form-group-modern">
          <label for="fee">Ticket Price (₹) *</label>
          <input type="number" id="fee" step="0.01" name="fee" placeholder="0 for Free" value="0" required class="modern-input">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group-modern">
          <label for="venue">Venue / Location *</label>
          <input type="text" id="venue" name="venue" placeholder="e.g. City Tech Center" required class="modern-input">
        </div>

        <div class="form-group-modern">
          <label for="capacity">Total Capacity *</label>
          <input type="number" id="capacity" name="capacity" placeholder="e.g. 250" value="100" required class="modern-input">
        </div>
      </div>

      <button type="submit" class="btn full btn-auth-submit" style="margin-top: 15px;">Publish Event Now</button>
      <div style="text-align: center; margin-top: 12px;">
        <a href="/admin" class="back-link">← Cancel and return to Admin Dashboard</a>
      </div>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
