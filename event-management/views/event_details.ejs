<%- include('partials/header') %>

<div class="page-container">
  <div class="breadcrumb-bar">
    <a href="/events" class="back-link">← Back to All Events</a>
  </div>

  <div class="event-details-layout">
    <!-- Left Column: Event Info & Reviews -->
    <div class="event-main-column">
      <div class="details-hero-card">
        <div class="details-badge-row">
          <span class="category-pill cat-tech">⭐ Featured Event</span>
          <span class="seats-badge <%= seats_left > 0 ? 'seats-available' : 'seats-soldout' %>">
            <%= seats_left > 0 ? (seats_left + ' Seats Remaining') : 'Sold Out' %>
          </span>
        </div>

        <h1 class="details-title"><%= event.title %></h1>

        <div class="details-meta-grid">
          <div class="meta-item">
            <div class="meta-icon meta-icon-date">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <div>
              <div class="meta-label">Date & Time</div>
              <div class="meta-value event-date-display" data-date="<%= (new Date(event.event_date)).toISOString() %>">
                <%= (new Date(event.event_date)).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>
          </div>

          <div class="meta-item">
            <div class="meta-icon meta-icon-venue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <div class="meta-label">Location / Venue</div>
              <div class="meta-value"><%= event.venue %></div>
            </div>
          </div>

          <div class="meta-item">
            <div class="meta-icon meta-icon-capacity">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div>
              <div class="meta-label">Total Capacity</div>
              <div class="meta-value"><%= event.capacity %> attendees</div>
            </div>
          </div>
        </div>

        <div class="details-description-box">
          <h3>About This Event</h3>
          <p class="event-desc-text"><%= event.description %></p>
        </div>
      </div>

      <!-- 💬 Reviews Section -->
      <section class="reviews-section">
        <div class="reviews-header-row">
          <div>
            <h2>Community Reviews</h2>
            <p class="reviews-sub">Feedback and ratings from verified participants</p>
          </div>
          <% if (reviews && reviews.length > 0) { %>
            <div class="rating-highlight-pill">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.5" style="display:inline-block; vertical-align:-1px; margin-right:4px;">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <span><%= (reviews.reduce((acc, r) => acc + Number(r.rating || 0), 0) / reviews.length).toFixed(1) %> / 5.0</span>
            </div>
          <% } %>
        </div>

        <% if (reviews && reviews.length > 0) { %>
          <div class="reviews-list">
            <% reviews.forEach(function(review) { %>
              <div class="review-card">
                <div class="review-header">
                  <div class="reviewer-profile">
                    <span class="reviewer-avatar"><%= (review.name || 'U').charAt(0).toUpperCase() %></span>
                    <div>
                      <span class="review-user"><%= review.name %></span>
                      <span class="review-date"><%= (new Date(review.created_at)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                  </div>
                  <div class="review-stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="star <%= i <= review.rating ? 'star-filled' : 'star-empty' %>">★</span>
                    <% } %>
                  </div>
                </div>
                <div class="review-comment"><%= review.comment %></div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-reviews-state">
            <div style="font-size: 2.2rem; margin-bottom: 8px;">💬</div>
            <p style="color: #718096; margin: 0;">No reviews yet. Be the first attendee to leave a review!</p>
          </div>
        <% } %>

        <% if (user) { %>
          <% if (!userHasReviewed) { %>
            <div class="review-form-wrapper">
              <h3>Leave a Review</h3>
              <form action="/reviews/<%= event.event_id %>" method="POST" class="review-form-styled">
                <div class="form-group">
                  <label for="rating">Rating</label>
                  <select name="rating" id="rating" required class="form-select">
                    <option value="">Select your rating</option>
                    <option value="5">⭐⭐⭐⭐⭐ 5 - Exceptional</option>
                    <option value="4">⭐⭐⭐⭐ 4 - Very Good</option>
                    <option value="3">⭐⭐⭐ 3 - Good</option>
                    <option value="2">⭐⭐ 2 - Fair</option>
                    <option value="1">⭐ 1 - Needs Improvement</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="comment">Your Feedback</label>
                  <textarea name="comment" id="comment" rows="3" maxlength="500" placeholder="Share your experience with the community..." required class="form-textarea"></textarea>
                </div>
                <button type="submit" class="btn btn-submit-review">Publish Review</button>
              </form>
            </div>
          <% } else { %>
            <div class="success-message" style="margin-top: 20px;">
              ✅ You have already submitted a review for this event. Thank you!
            </div>
          <% } %>
        <% } else { %>
          <div class="login-prompt-box">
            <p>Want to leave a review?</p>
            <a href="/login" class="btn small">Log In to Review</a>
          </div>
        <% } %>
      </section>
    </div>

    <!-- Right Column: Sticky Booking Widget -->
    <div class="event-sidebar-column">
      <div class="booking-card-sticky">
        <div class="booking-header">
          <div class="ticket-price-display">
            <% if (Number(event.fee) === 0) { %>
              <span class="price-val free-val">Free Entry</span>
            <% } else { %>
              <span class="price-val">₹<%= Number(event.fee).toLocaleString() %></span>
              <span class="price-unit">/ person</span>
            <% } %>
          </div>
        </div>

        <!-- Seats Progress Bar -->
        <div class="seats-progress-container">
          <% 
            const bookedCount = (event.capacity || 0) - (seats_left || 0);
            const percentBooked = event.capacity > 0 ? Math.min(100, Math.round((bookedCount / event.capacity) * 100)) : 0;
          %>
          <div class="progress-labels">
            <span>Availability</span>
            <span><%= seats_left %> seats left</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" style="width: <%= percentBooked %>%;"></div>
          </div>
        </div>

        <% if (user) { %>
          <% if (seats_left > 0) { %>
            <form action="/register/<%= event.event_id %>" method="POST" class="booking-form-widget" id="bookingForm">
              <label class="ticket-selector-label">Number of Tickets</label>
              <div class="ticket-counter-controls">
                <button type="button" class="counter-btn" id="decreaseTickets">-</button>
                <input type="number" name="ticket_count" id="ticketCountInput" min="1" max="<%= seats_left %>" value="1" required class="ticket-number-input">
                <button type="button" class="counter-btn" id="increaseTickets">+</button>
              </div>

              <div class="order-summary-box">
                <div class="summary-line">
                  <span>Price per ticket</span>
                  <span>₹<%= Number(event.fee).toLocaleString() %></span>
                </div>
                <div class="summary-line total-line">
                  <span>Total Amount</span>
                  <span id="totalPriceDisplay">₹<%= Number(event.fee).toLocaleString() %></span>
                </div>
              </div>

              <button type="submit" class="btn btn-book-now">Complete Booking & Confirm</button>
            </form>
          <% } else { %>
            <div class="soldout-notice">
              <h3>🚫 Sold Out</h3>
              <p>All tickets for this event have been claimed.</p>
            </div>
          <% } %>
        <% } else { %>
          <div class="guest-booking-box">
            <p>Please log in or create an account to reserve your tickets.</p>
            <a href="/login" class="btn full btn-book-now">Login to Book Tickets</a>
            <div style="text-align: center; margin-top: 10px;">
              <small>New here? <a href="/register" style="color: var(--primary-color); font-weight: 600;">Sign up free</a></small>
            </div>
          </div>
        <% } %>

        <div class="booking-guarantees">
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>Instant booking confirmation</span>
          </div>
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Verified organizers & secure payments</span>
          </div>
          <div class="guarantee-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Digital QR access on your device</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic Ticket Counter and Subtotal Calculator
  document.addEventListener('DOMContentLoaded', function() {
    const feePerTicket = <%= Number(event.fee) || 0 %>;
    const maxSeats = <%= seats_left || 0 %>;
    const input = document.getElementById('ticketCountInput');
    const totalDisplay = document.getElementById('totalPriceDisplay');
    const btnDec = document.getElementById('decreaseTickets');
    const btnInc = document.getElementById('increaseTickets');

    function updateTotal() {
      if (!input) return;
      let count = parseInt(input.value, 10) || 1;
      if (count < 1) count = 1;
      if (count > maxSeats) count = maxSeats;
      input.value = count;
      const total = count * feePerTicket;
      if (totalDisplay) {
        totalDisplay.textContent = '₹' + total.toLocaleString();
      }
    }

    if (btnDec && input) {
      btnDec.addEventListener('click', function() {
        let val = parseInt(input.value, 10) || 1;
        if (val > 1) {
          input.value = val - 1;
          updateTotal();
        }
      });
    }

    if (btnInc && input) {
      btnInc.addEventListener('click', function() {
        let val = parseInt(input.value, 10) || 1;
        if (val < maxSeats) {
          input.value = val + 1;
          updateTotal();
        }
      });
    }

    if (input) {
      input.addEventListener('input', updateTotal);
    }
  });
</script>

<%- include('partials/footer') %>
