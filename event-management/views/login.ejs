<%- include('partials/header') %>
<section class="auth-page-section">
  <div class="auth-card-modern">
    <div class="auth-header">
      <div class="auth-icon-circle">🔐</div>
      <h1>Welcome Back</h1>
      <p>Log in to access your booked events and tickets</p>
    </div>

    <!-- Quick Demo Logins Helper -->
    <div class="quick-login-pills">
      <span class="quick-title">Quick Demo Login:</span>
      <button type="button" class="demo-pill-btn" onclick="fillCredentials('user@example.com', 'user123')">
        👤 Demo User
      </button>
      <button type="button" class="demo-pill-btn admin-pill" onclick="fillCredentials('admin@example.com', 'admin123')">
        👑 Admin
      </button>
    </div>

    <form action="/login" method="POST" class="auth-form-styled">
      <div class="form-group-modern">
        <label for="email">Email Address</label>
        <div class="input-with-icon">
          <span class="field-icon">✉️</span>
          <input type="email" id="email" name="email" placeholder="name@example.com" required class="modern-input">
        </div>
      </div>

      <div class="form-group-modern">
        <div class="label-with-link">
          <label for="password">Password</label>
          <a href="/forgot-password" class="forgot-link">Forgot password?</a>
        </div>
        <div class="input-with-icon">
          <span class="field-icon">🔒</span>
          <input type="password" id="password" name="password" placeholder="Enter your password" required class="modern-input">
        </div>
      </div>
      
      <div class="remember-me-container">
        <label class="remember-me-label">
          <input type="checkbox" name="rememberMe" class="remember-me-checkbox" checked>
          <span class="checkmark"></span>
          Keep me signed in for 30 days
        </label>
      </div>
      
      <button type="submit" class="btn full btn-auth-submit">Sign In to Evantra</button>

      <div class="auth-card-footer">
        Don't have an account yet? <a href="/register">Create an account free</a>
      </div>
    </form>
  </div>
</section>

<script>
  function fillCredentials(email, pass) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = pass;
    const btn = document.querySelector('.btn-auth-submit');
    btn.style.transform = 'scale(1.02)';
    setTimeout(() => { btn.style.transform = 'scale(1)'; }, 200);
  }
</script>

<%- include('partials/footer') %>
